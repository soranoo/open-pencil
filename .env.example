# Frontend environment defaults. Vite exposes only VITE_* values to the app.

# Optional backend design service.
VITE_OPENPENCIL_SERVER_URL=http://localhost:8787
VITE_IS_BACKEND_MODE=false
VITE_OPENPENCIL_SERVER_SAVE_DEBOUNCE_MS=1200

# Enable autosave by default for writable local documents.
VITE_OPENPENCIL_AUTOSAVE=false
# Disable local autosave and local unsaved-work recovery persistence.
VITE_DISABLE_LOCAL_UNSAVED_WORK=false
# Disable the Settings modal and its open actions.
VITE_DISABLE_SETTINGS_MODAL=false

# Optional feature flags.
VITE_DISABLE_TAB=false
VITE_DISABLE_COLLABORATION=false
VITE_DISABLE_UI_CODE_TAB=false
VITE_DISABLE_AI_CHAT=false
