# Copy this file to .env and adjust as needed.
# Every value has a sane default; only OPENPENCIL_URL is commonly changed.
# All values can also be overridden per-call via OpenPencilAutomation.connect({...}).

# -----------------------------------------------------------------------------
# Where the Open-Pencil dev server is already running.
# Start it separately first: `bun run dev` from the repo root (or `bun run
# dev` inside the Open-Pencil app package), then point this at it.
# -----------------------------------------------------------------------------
OPENPENCIL_URL=http://localhost:1420

# -----------------------------------------------------------------------------
# Remote-control hub (the WebSocket server this package starts; the
# Open-Pencil frontend dials out to it).
# Port 0 = pick a free port automatically (recommended, avoids collisions
# when running multiple automation processes at once).
# -----------------------------------------------------------------------------
OPENPENCIL_REMOTE_CONTROL_HOST=127.0.0.1
OPENPENCIL_REMOTE_CONTROL_PORT=0

# Shared secret the frontend must present to the hub before it will accept
# commands. Leave unset to auto-generate a random token per run (fine for
# local/dev use, since the hub only accepts connections from pages this
# process itself navigates to).
# OPENPENCIL_REMOTE_CONTROL_TOKEN=

# -----------------------------------------------------------------------------
# Puppeteer / browser behaviour
# -----------------------------------------------------------------------------
# Visible browser window by default, for debugging. Set to true for headless CI.
OPENPENCIL_HEADLESS=false
OPENPENCIL_VIEWPORT_WIDTH=1980
OPENPENCIL_VIEWPORT_HEIGHT=1080

# Max number of concurrent browser sessions (isolated contexts) the cluster
# will run at once. Each concurrent client.createSession()/sendAI() call
# consumes one slot.
OPENPENCIL_MAX_CONCURRENCY=4

# -----------------------------------------------------------------------------
# Timeouts (milliseconds)
# -----------------------------------------------------------------------------
# How long to wait for a page to load Open-Pencil and register with the hub.
OPENPENCIL_READY_TIMEOUT_MS=30000
# How long to wait for a single AI design request to finish.
OPENPENCIL_AI_TIMEOUT_MS=3600000
# How long to wait for a .fig export to complete.
OPENPENCIL_DOWNLOAD_TIMEOUT_MS=20000
# How long to wait for an ai.configure command to complete.
OPENPENCIL_AI_CONFIGURE_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# AI model configuration (optional)
# -----------------------------------------------------------------------------
# Set OPENPENCIL_AI_PROVIDER + OPENPENCIL_AI_TOKEN to point Open-Pencil's AI
# chat at a custom endpoint/model/token automatically on every session -
# no manual Settings-dialog steps required. Leave OPENPENCIL_AI_PROVIDER unset
# to skip this entirely and use whatever provider is already configured in
# the browser profile.
#
# Named provider, e.g. Anthropic direct:
#   OPENPENCIL_AI_PROVIDER=anthropic
#   OPENPENCIL_AI_MODEL=claude-sonnet-4-6-20260301
#   OPENPENCIL_AI_TOKEN=sk-ant-...
#
# Fully custom / self-hosted endpoint (OpenAI-compatible):
#   OPENPENCIL_AI_PROVIDER=openai-compatible
#   OPENPENCIL_AI_BASE_URL=https://my-llm-gateway.internal/v1
#   OPENPENCIL_AI_CUSTOM_MODEL=my-org/design-model-v2
#   OPENPENCIL_AI_TOKEN=my-gateway-token
#
# OPENPENCIL_AI_PROVIDER=
# OPENPENCIL_AI_MODEL=
# OPENPENCIL_AI_CUSTOM_MODEL=
# OPENPENCIL_AI_BASE_URL=
# OPENPENCIL_AI_API_TYPE=completions
# OPENPENCIL_AI_TOKEN=
# OPENPENCIL_AI_MAX_OUTPUT_TOKENS=16384
# OPENPENCIL_AI_MODEL_NAME=
