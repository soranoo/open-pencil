# --- HTTP ---
PORT=8787
CORS_ORIGIN=http://localhost:1420
ENABLE_OPENAPI_DOCS=true
SERVER_API_KEY=replace-with-a-shared-server-api-key

# --- Open-Pencil frontend ---
# The running Open-Pencil web app this server automates (see
# ../automation/README.md). Also used to build the signed "open this saved
# design" URLs handed out by GET /design/:id/url.
FRONTEND_URL=http://localhost:1420

# Set to skip real browser automation entirely and return a canned response —
# useful for exercising queue/db/storage wiring without a running frontend or
# AI credentials.
USE_AI_STUB=false

# --- Browser automation / AI model (@open-pencil/automation) ---
# All of this is configured via that package's own OPENPENCIL_* env vars —
# see ../automation/.env.example for the full list (OPENPENCIL_URL should
# usually just match FRONTEND_URL above). Nothing AI/browser-specific lives
# in this server's own env — copy the relevant vars from there into this
# same .env file, e.g.:
#
#   OPENPENCIL_URL=http://localhost:1420
#   OPENPENCIL_HEADLESS=true
#   OPENPENCIL_AI_PROVIDER=anthropic
#   OPENPENCIL_AI_MODEL=claude-sonnet-4-6-20260301
#   OPENPENCIL_AI_TOKEN=sk-ant-...
#
# Exception: browser concurrency is controlled by this server's own
# AI_MAX_CONCURRENCY_PER_WORKER below (passed straight through as the
# automation package's `concurrency` option) rather than
# OPENPENCIL_MAX_CONCURRENCY, so you only need to set it in one place.

# --- Object storage ---
# One of: fs | s3
STORE_PROVIDER=fs
# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, ...).
# Required when STORE_PROVIDER=s3.
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=openpencil-designs
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
# set to "true" for MinIO / R2 / anything that isn't virtual-hosted-style AWS S3
S3_FORCE_PATH_STYLE=true

# Filesystem storage directory (used when STORE_PROVIDER=fs)
STORAGE_DIR=./tmp/data

# --- Metadata DB ---
# One of: memory | fs | postgres
DB_PROVIDER=memory
POSTGRES_DATABASE_URL=postgres://user:password@localhost:5432/openpencil

# --- KV/session store ---
# One of: memory | redis | fs
KV_PROVIDER=memory
# Required when KV_PROVIDER=redis
REDIS_URL=redis://localhost:6379

# --- Design signing (signed "open this saved design" URLs + auth cookie) ---
DESIGN_SIGNING_SECRET=replace-with-a-random-signing-secret
DESIGN_FIRST_ACCESS_TTL_MINUTES=300
DESIGN_COOKIE_TTL_MINUTES=60
DESIGN_COOKIE_REFRESH_INTERVAL_MINUTES=15

# --- Session behavior ---
# Minutes an unsaved in-progress design's KV session record is kept alive.
SESSION_TTL_MINUTES=30
# --- Generate queue ---
# One of: memory | fs | amqp
QUEUE_PROVIDER=memory
# Required when QUEUE_PROVIDER=amqp
AMQP_URL=amqp://localhost:5672
# Queue topic prefix/name used by AMQP provider
AMQP_QUEUE_NAME=openpencil.generate
# Max concurrent /generate jobs this worker processes — each one maps to one
# browser session, so this is also what gets passed as @open-pencil/automation's
# `concurrency` option (see note above).
AI_MAX_CONCURRENCY_PER_WORKER=1
