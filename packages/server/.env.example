# --- HTTP ---
PORT=8787

# --- Model provider (BYO key, same providers the in-app chat supports) ---
# One of: anthropic | openai | google | deepseek | openrouter | zai | minimax
#         | openai-compatible | anthropic-compatible
AI_PROVIDER_ID=anthropic
AI_API_KEY=sk-ant-xxxxx
AI_MODEL_ID=claude-sonnet-4-6
AI_MAX_OUTPUT_TOKENS=8192
# only needed for *-compatible providers:
AI_CUSTOM_BASE_URL=
AI_CUSTOM_MODEL_ID=
AI_CUSTOM_API_TYPE=completions

# --- S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, Backblaze B2, ...) ---
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=openpencil-designs
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
# set to "true" for MinIO / R2 / anything that isn't virtual-hosted-style AWS S3
S3_FORCE_PATH_STYLE=true

# --- Metadata DB ---
DATABASE_URL=postgres://user:password@localhost:5432/openpencil

# --- Session behavior ---
# minutes an unsaved in-memory session is kept alive before being discarded
SESSION_TTL_MINUTES=30
