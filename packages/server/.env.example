# --- HTTP ---
PORT=8787
FRONTEND_URL=http://localhost:1420
SERVER_API_KEY=replace-with-a-shared-server-api-key

# --- Model provider (BYO key, same providers the in-app chat supports) ---
# One of: anthropic | openai | google | deepseek | openrouter | zai | minimax
#         | openai-compatible | anthropic-compatible
AI_PROVIDER_ID=anthropic
AI_API_KEY=sk-ant-xxxxx
AI_MODEL_ID=claude-sonnet-4-6
# only needed for *-compatible providers:
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_TYPE=completions

# --- Object storage ---
# S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2, ...).
# If S3_ENDPOINT is unset, falls back to the local filesystem (STORAGE_DIR).
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=openpencil-designs
S3_ACCESS_KEY_ID=xxxxx
S3_SECRET_ACCESS_KEY=xxxxx
# set to "true" for MinIO / R2 / anything that isn't virtual-hosted-style AWS S3
S3_FORCE_PATH_STYLE=true

# Filesystem storage directory (used when S3_ENDPOINT is not set or KV_PROVIDER=fs)
STORAGE_DIR=./data

# --- Metadata DB ---
DATABASE_URL=postgres://user:password@localhost:5432/openpencil

# --- KV/session store ---
# One of: memory | redis | fs
KV_PROVIDER=memory
# Required when KV_PROVIDER=redis
REDIS_URL=redis://localhost:6379

# --- Session behavior ---
# minutes an unsaved in-memory session is kept alive before being discarded
SESSION_TTL_MINUTES=30

# --- Generate queue ---
# One of: memory | fs | amqp
QUEUE_PROVIDER=memory
# Required when QUEUE_PROVIDER=amqp
AMQP_URL=amqp://localhost:5672
# Queue topic prefix/name used by AMQP provider
AMQP_QUEUE_NAME=openpencil.generate
# Max concurrent AI generation jobs each server worker can process
AI_MAX_CONCURRENCY_PER_WORKER=1
