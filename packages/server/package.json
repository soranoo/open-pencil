{
  "name": "@open-pencil/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless prompt-to-design backend. Reuses @open-pencil/core directly — no browser, no MCP, no ACP agents.",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "psql \"$DATABASE_URL\" -f src/db/schema.sql"
  },
  "dependencies": {
    "@open-pencil/core": "^0.13.2",
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/openai": "^2",
    "@ai-sdk/google": "^2",
    "@ai-sdk/deepseek": "^1",
    "@ai-sdk/valibot": "^2",
    "@openrouter/ai-sdk-provider": "^1",
    "ai": "^6",
    "valibot": "^1",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "pg": "^8",
    "hono": "^4",
    "@hono/node-server": "^1",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
