{
  "name": "@open-pencil/server",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Headless prompt-to-design backend. Reuses @open-pencil/core directly — no browser, no MCP, no ACP agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soranoo/open-pencil.git",
    "directory": "packages/server"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run tsdown --config tsdown.config.ts",
    "start": "node dist/index.js",
    "migrate": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/deepseek": "^1",
    "@ai-sdk/google": "^2",
    "@ai-sdk/openai": "^2",
    "@ai-sdk/valibot": "^2",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@hono/node-server": "^1",
    "@hono/standard-validator": "^0.3.0",
    "@hono/swagger-ui": "^0.6.1",
    "@open-pencil/core": "workspace:*",
    "@open-pencil/scene-graph": "workspace:*",
    "@openrouter/ai-sdk-provider": "^1",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^6",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "assert-never": "^1.4.0",
    "hono": "^4",
    "hono-openapi": "^1.3.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.5",
    "pg": "^8",
    "uuid": "^14.0.1",
    "valibot": "^1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsdown": "^0.22.14",
    "tsx": "^4",
    "typescript": "^5"
  }
}
