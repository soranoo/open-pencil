{
  "name": "@open-pencil/server",
  "version": "0.1.0",
  "private": true,
  "description": "Headless prompt-to-design backend. Reuses @open-pencil/core directly — no browser, no MCP, no ACP agents.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "psql \"$DATABASE_URL\" -f src/db/schema.sql",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2",
    "@ai-sdk/deepseek": "^1",
    "@ai-sdk/google": "^2",
    "@ai-sdk/openai": "^2",
    "@ai-sdk/valibot": "^2",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@hono/node-server": "^1",
    "@open-pencil/core": "^0.13.2",
    "@openrouter/ai-sdk-provider": "^1",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^6",
    "hono": "^4",
    "pg": "^8",
    "valibot": "^1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
